# Crie uma chave gratuita em https://brapi.dev e mantenha-a somente no backend.
BRAPI_TOKEN=
# Limites preventivos locais. Deixe margem abaixo da cota oficial do seu plano.
BRAPI_MAX_DAILY_REQUESTS=250
BRAPI_MAX_31_DAY_REQUESTS=14000
# Atualização intradiária dos scans. Histórico/rankings continuam diários.
LIVE_SCAN_QUOTE_TTL_MINUTES=60
PORT=8787
# PostgreSQL do Supabase. Nunca envie este valor ao frontend ou ao Git.
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJETO.supabase.co:5432/postgres
# Cria o primeiro usuário somente se ainda não existir nenhum com este e-mail.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte-com-12-ou-mais-caracteres
ADMIN_NAME=Administrador
# Opcional: lista CSV para contingência se a composição pública da B3 estiver indisponível.
IBOV_SYMBOLS=PETR4,VALE3,ITUB4,BBAS3,BBDC4,WEGE3,PRIO3,SUZB3
# Diretório privado para anexos do Diário. Em produção, use um volume persistente fora do repositório.
JOURNAL_ATTACHMENT_STORAGE_PATH=
# Twelve Data API (Ações americanas / Nasdaq-100 EOD - Uso pessoal / interno)
TWELVE_DATA_API_KEY=
TWELVE_DATA_DAILY_CREDIT_LIMIT=800
TWELVE_DATA_SAFE_DAILY_CREDIT_LIMIT=700
TWELVE_DATA_MAX_CREDITS_PER_MINUTE=8
TWELVE_DATA_ENABLED=true
NASDAQ100_RELATIVE_STRENGTH_ENABLED=true
